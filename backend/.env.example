# Copy this file to .env and fill in the values.

# 1) Supabase Postgres connection string (Supabase dashboard -> Connect -> Session pooler).
#    Replace [YOUR-PASSWORD] with your database password (URL-encode special characters).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# 2) Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: a GitHub token raises GitHub's rate limit (useful when comparing several repos)
# GITHUB_TOKEN=ghp_xxx

# Optional: override the Gemini models
# GEMINI_MODEL=gemini-3.8-flash
# Optional: set a different supported model to retry after overload/rate limits.
# GEMINI_FALLBACK_MODEL=another-supported-model
